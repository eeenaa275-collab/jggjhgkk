import telebot.apihelper

_original_make_request = telebot.apihelper._make_request

def _patched_make_request(token, method_url, params=None, files=None, method='get'):
    try:
        return _original_make_request(token, method_url, params=params, files=files, method=method)
    except telebot.apihelper.ApiTelegramException as e:
        if "message is not modified" in str(e):
            return {"ok": True, "result": True}
        raise

telebot.apihelper._make_request = _patched_make_request


