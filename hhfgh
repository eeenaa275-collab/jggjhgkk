@bot.message_handler(func=lambda m: user_states.get(m.from_user.id) == "waiting_topup_amount")
def handle_topup_amount(message):
    try:
        amount = int(message.text.strip())
    except:
        return bot.reply_to(message, f"❌ Введите число от {MIN_TOPUP} до {MAX_TOPUP}")

    if amount < MIN_TOPUP or amount > MAX_TOPUP:
        return bot.reply_to(message, f"❌ Сумма должна быть от {MIN_TOPUP}₽ до {MAX_TOPUP}₽")

    user_states.pop(message.from_user.id, None)
    pid = create_payment(message.from_user.id, amount)

    text = (
        f"💳 <b>Оплата заявки #{pid}</b>\n"
        "━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        f"💰 Сумма: <b>{amount}₽</b>\n\n"
        f"📱 <b>Переведите сумму на карту:</b>\n"
        f"<code>{CARD_NUMBER}</code>\n\n"
        f"⏰ <b>У вас {PAYMENT_TIMEOUT_MIN} минут</b> на оплату.\n"
        "После этого заявка будет отменена.\n\n"
        "Когда переведёте — нажмите <b>«✅ Я оплатил»</b>.\n"
        "━━━━━━━━━━━━━━━━━━━━━━━"
    )
    bot.send_message(message.chat.id, text,
                     reply_markup=payment_kb(pid), parse_mode="HTML")

    threading.Thread(target=payment_timeout, args=(message.from_user.id, pid), daemon=True).start()


def payment_timeout(user_id, pid):
    time.sleep(PAYMENT_TIMEOUT_MIN * 60)
    payment = get_payment(pid)
    if not payment:
        return
    if payment[3] == "pending":
        set_payment_status(pid, "expired")
        try:
            bot.send_message(
                user_id,
                f"⏰ <b>Заявка #{pid} отменена</b>\n\n"
                f"Прошло {PAYMENT_TIMEOUT_MIN} минут — оплата не поступила.\n"
                "Создайте новую заявку в меню.",
                parse_mode="HTML"
            )
        except:
            pass


