def init_db():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
        tg_id INTEGER PRIMARY KEY,
        username TEXT,
        first_name TEXT,
        registered_at TEXT,
        balance INTEGER DEFAULT 0,
        sub_status TEXT DEFAULT 'Неактивна',
        sub_until TEXT,
        trial_used INTEGER DEFAULT 0
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS payments (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tg_id INTEGER,
        amount INTEGER,
        status TEXT DEFAULT 'pending',
        created_at TEXT,
        confirmed_at TEXT
    )''')
    c.execute('''CREATE TABLE IF NOT EXISTS subscriptions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tg_id INTEGER,
        tariff_name TEXT,
        days INTEGER,
        price INTEGER,
        vpn_key TEXT,
        activated_at TEXT,
        expires_at TEXT,
        status TEXT DEFAULT 'Активна'
    )''')
    cursor = c.execute("PRAGMA table_info(subscriptions)")
    cols = [row[1] for row in cursor.fetchall()]
    if 'vpn_key' not in cols:
        c.execute("ALTER TABLE subscriptions ADD COLUMN vpn_key TEXT")
    conn.commit()
    conn.close()


def add_user(tg_id, username, first_name):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    now = datetime.datetime.now().isoformat()
    c.execute('''INSERT OR IGNORE INTO users 
                 (tg_id, username, first_name, registered_at)
                 VALUES (?, ?, ?, ?)''', (tg_id, username or "", first_name or "", now))
    conn.commit()
    conn.close()


def get_user(tg_id):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE tg_id = ?", (tg_id,))
    row = c.fetchone()
    conn.close()
    return row


def set_trial_used(tg_id):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    expire = (datetime.datetime.now() + datetime.timedelta(days=5)).isoformat()
    c.execute("UPDATE users SET trial_used = 1, sub_status = 'Активна (пробная)', sub_until = ? WHERE tg_id = ?",
              (expire, tg_id))
    conn.commit()
    conn.close()


def add_balance(tg_id, amount):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("UPDATE users SET balance = balance + ? WHERE tg_id = ?", (amount, tg_id))
    conn.commit()
    conn.close()


def deduct_balance(tg_id, amount):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT balance FROM users WHERE tg_id = ?", (tg_id,))
    row = c.fetchone()
    if not row or row[0] < amount:
        conn.close()
        return False
    c.execute("UPDATE users SET balance = balance - ? WHERE tg_id = ?", (amount, tg_id))
    conn.commit()
    conn.close()
    return True


def activate_subscription(tg_id, days):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT sub_until FROM users WHERE tg_id = ?", (tg_id,))
    row = c.fetchone()
    base = datetime.datetime.now()
    if row and row[0]:
        try:
            old = datetime.datetime.fromisoformat(row[0])
            if old > base:
                base = old
        except:
            pass
    expire = (base + datetime.timedelta(days=days)).isoformat()
    c.execute("UPDATE users SET sub_status = 'Активна', sub_until = ? WHERE tg_id = ?",
              (expire, tg_id))
    conn.commit()
    conn.close()
    return expire


def add_subscription_record(tg_id, tariff_name, days, price, vpn_key, expires_at):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute('''INSERT INTO subscriptions 
                 (tg_id, tariff_name, days, price, vpn_key, activated_at, expires_at, status)
                 VALUES (?, ?, ?, ?, ?, ?, ?, 'Активна')''',
              (tg_id, tariff_name, days, price, vpn_key,
               datetime.datetime.now().isoformat(), expires_at))
    conn.commit()
    conn.close()


def get_user_subscriptions(tg_id):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute('''SELECT id, tariff_name, days, price, vpn_key, activated_at, expires_at, status
                 FROM subscriptions WHERE tg_id = ?
                 ORDER BY id DESC''', (tg_id,))
    rows = c.fetchall()
    conn.close()
    return rows


def update_expired_subscriptions():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    now = datetime.datetime.now().isoformat()
    c.execute('''UPDATE subscriptions SET status = 'Истекла'
                 WHERE expires_at < ? AND status = 'Активна' ''', (now,))
    conn.commit()
    conn.close()


def create_payment(tg_id, amount):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    now = datetime.datetime.now().isoformat()
    c.execute('''INSERT INTO payments (tg_id, amount, status, created_at)
                 VALUES (?, ?, 'pending', ?)''', (tg_id, amount, now))
    pid = c.lastrowid
    conn.commit()
    conn.close()
    return pid


def get_payment(pid):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT id, tg_id, amount, status, created_at FROM payments WHERE id = ?", (pid,))
    row = c.fetchone()
    conn.close()
    return row


def set_payment_status(pid, status):
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("UPDATE payments SET status = ?, confirmed_at = ? WHERE id = ?",
              (status, datetime.datetime.now().isoformat(), pid))
    conn.commit()
    conn.close()


